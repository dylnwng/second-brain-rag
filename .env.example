# Copy to .env and fill in. Never commit .env.

# Path to the markdown notes to index. Read-only: nothing under it is ever written.
VAULT_PATH=/path/to/your/vault/wiki
# Comma-separated globs (relative to VAULT_PATH) to skip, e.g. changelogs and lint output.
EXCLUDE_GLOBS=log.md,lint-report.md

# Firestore auth is Application Default Credentials:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-project-id
FIRESTORE_DATABASE=(default)

# Embeddings + generation backend.
#   gemini_api: AI Studio API key, has a free tier. Free-tier inputs may be used by Google
#               to improve its products; use a paid key or Vertex for sensitive notes.
#   vertex:     Vertex AI (Gemini Enterprise Agent Platform); needs billing on the project.
GENAI_BACKEND=gemini_api
GEMINI_API_KEY=
GOOGLE_CLOUD_LOCATION=global
# Generation models, tried in order; the next one is used only on 429/5xx/timeout.
# Probed 2026-10-18 on the free tier: 3.8/3.7-flash were timing out; Flash models allow
# 20 requests/day/model, so the chain ends with Flash-Lite models.
GEN_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
TOP_K=5

EMBED_MODEL=gemini-embedding-2
# Firestore vector fields max out at 2048 dims; gemini-embedding-2 supports 128-3072 (MRL).
EMBED_DIM=1536
# USD per 1M input tokens, used for the cost line in ingestion output. 0 on the Gemini API
# free tier. Paid rate for gemini-embedding-2 is $0.20/1M per third-party trackers (Jun 2026);
# confirm on Google's pricing page. A config value, not a measurement.
EMBED_PRICE_PER_1M_TOKENS=0

CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
